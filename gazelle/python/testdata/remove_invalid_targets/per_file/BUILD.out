load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# gazelle:python_generation_mode file

py_binary(
    name = "my_bin",
    srcs = ["my_bin.py"],
    visibility = ["//:__subpackages__"],
)

py_library(
    name = "my_lib",
    srcs = ["my_lib.py"],
    visibility = ["//:__subpackages__"],
)

py_test(
    name = "my_test",
    srcs = ["my_test.py"],
)
